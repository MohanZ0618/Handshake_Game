{
  "name": "blockfire-arena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/local.ts\" \"vite --host 0.0.0.0\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "worker:dev": "wrangler dev",
    "worker:check": "wrangler deploy --dry-run --outdir worker-dist",
    "worker:deploy": "wrangler deploy",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "concurrently": "^9.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0",
    "ws": "^8.18.0"
  }
}
